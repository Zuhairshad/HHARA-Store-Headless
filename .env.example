# ─── Shopify (server-only) ───
# Store's .myshopify.com domain and the Headless channel's Storefront API token.
SHOPIFY_STORE_DOMAIN="cuxtmt-tw.myshopify.com"
SHOPIFY_STOREFRONT_TOKEN="your_headless_channel_storefront_token"
# Admin API token (customers, subscribers, order lookup). Scopes: read/write_customers, read_orders.
SHOPIFY_ADMIN_TOKEN="shpat_xxx"
# Signing secret shown under Settings → Notifications → Webhooks; verifies product webhooks to /api/revalidate.
SHOPIFY_WEBHOOK_SECRET=""
# Manual catalogue purge: POST /api/revalidate?secret=… (leave empty to disable).
REVALIDATION_TOKEN=""
# The API version is set in code (SHOPIFY_API_VERSION in src/lib/shopify.ts). Delete any SHOPIFY_API_VERSION env var.

# ─── Shopify public IDs (optional; defaults in src/lib/shopify/analytics-config.ts are the live store's) ───
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN="cuxtmt-tw.myshopify.com"
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=""
NEXT_PUBLIC_SHOPIFY_SHOP_ID="72899690678"
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ID="172869484726"
NEXT_PUBLIC_CHECKOUT_DOMAIN="checkout.hhara.com"
NEXT_PUBLIC_STOREFRONT_ROOT_DOMAIN="hhara.com"

# ─── Site ───
NEXT_PUBLIC_SITE_URL="https://www.hhara.com"
NEXT_PUBLIC_SITE_LAUNCHED="true"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# ─── Analytics & ad pixels (public IDs; each one is off when empty) ───
# Use the SAME IDs as the Shopify Google & YouTube / Facebook & Instagram / TikTok apps, which track checkout + purchase.
NEXT_PUBLIC_GA4_ID=""          # G-XXXXXXXXXX
NEXT_PUBLIC_GADS_ID=""         # AW-XXXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=""   # 15-16 digits
NEXT_PUBLIC_TIKTOK_PIXEL_ID="" # C… / D…

# ─── Klaviyo (server-only) ───
KLAVIYO_PRIVATE_API_KEY="pk_xxx"
KLAVIYO_LIST_ID="XXXXXX"

# ─── Order tracking carriers (server-only, optional) ───
DHL_API_KEY=""
QUIQUP_CLIENT_ID=""
QUIQUP_API_KEY=""
NAQEL_USERNAME=""
NAQEL_PASSWORD=""
NAQEL_API_TOKEN=""

# ─── Misc ───
REVIEW_NOTIFY_EMAIL=""
BEHOLD_FEED_URL=""             # Instagram feed (behold.so JSON link)
