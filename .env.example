# ─── Shopify Commerce (Server-Only Secrets) ───
SHOPIFY_STORE_DOMAIN="hhara-store.myshopify.com"
SHOPIFY_STOREFRONT_TOKEN="your_storefront_access_token"
SHOPIFY_ADMIN_TOKEN="your_admin_access_token"
SHOPIFY_API_VERSION="2025-01"

# ─── Public Site & Storefront Configuration ───
NEXT_PUBLIC_SITE_URL="https://hhara.com"
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN="hhara-store.myshopify.com"

# ─── Analytics & Advertising Pixels (Optional Public IDs) ───
NEXT_PUBLIC_GA4_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GADS_ID="AW-XXXXXXXXXXX"
NEXT_PUBLIC_META_PIXEL_ID="123456789012345"
NEXT_PUBLIC_TIKTOK_PIXEL_ID="XXXXXXXXXXXXXXX"
